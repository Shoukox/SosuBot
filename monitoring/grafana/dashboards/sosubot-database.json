      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
      "id": 7,
      "options": { "displayMode": "gradient", "minVizHeight": 10, "minVizWidth": 0, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "sizing": "auto", "valueMode": "color" },
      "targets": [{ "expr": "max by (language) (sosubot_chats_by_language)", "instant": true, "legendFormat": "{{language}}", "refId": "A" }],
      "title": "Chats by language",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "displayName": "${__field.labels.entity}", "min": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "id": 8,
      "options": { "displayMode": "gradient", "minVizHeight": 10, "minVizWidth": 0, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true, "sizing": "auto", "valueMode": "color" },
      "targets": [{ "expr": "max by (entity) (sosubot_database_entities)", "instant": true, "legendFormat": "{{entity}}", "refId": "A" }],
      "title": "Persisted database entities",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 12 },
      "id": 9,
      "options": { "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "max by (country, metric) (sosubot_latest_daily_statistic)", "legendFormat": "{{country}} / {{metric}}", "refId": "A" }],
      "title": "Latest daily statistics from PostgreSQL",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "displayName": "${__field.labels.country}", "unit": "dateTimeAsIso" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 12 },
      "id": 10,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "expr": "max by (country) (sosubot_latest_daily_statistic_unixtime) * 1000", "instant": true, "legendFormat": "{{country}}", "refId": "A" }],
      "title": "Latest statistic date by country",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "unit": "dateTimeAsIso" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 21 },
      "id": 11,
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "max(sosubot_database_metrics_last_success_unixtime) * 1000", "instant": true, "refId": "A" }],
      "title": "Last successful database refresh",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 120 }, { "color": "red", "value": 300 }] }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 21 },
      "id": 12,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "time() - max(sosubot_database_metrics_last_success_unixtime)", "instant": true, "refId": "A" }],
      "title": "Database snapshot age",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 21 },
      "id": 13,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "sum(increase(sosubot_database_metrics_refresh_failures_total[24h]))", "refId": "A" }],
      "title": "Database refresh failures / 24h",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 3, "min": 0, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 21 },
      "id": 14,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(sosubot_database_metrics_refresh_duration_seconds_bucket[5m])))", "refId": "A" }],
      "title": "Database refresh duration p95",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 3, "min": 0, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 25 },
      "id": 15,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(sosubot_database_metrics_refresh_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(sosubot_database_metrics_refresh_duration_seconds_bucket[$__rate_interval])))", "legendFormat": "p95", "refId": "B" }
      ],
      "title": "Database metrics refresh duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 4, "min": 0, "unit": "ops" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 25 },
      "id": 16,
      "options": { "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [{ "expr": "sum(rate(sosubot_database_metrics_refresh_failures_total[$__rate_interval]))", "legendFormat": "failures / second", "refId": "A" }],
      "title": "Database metrics refresh failures",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["sosubot", "database", "postgresql"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "SosuBot Database Statistics",
  "uid": "sosubot-database",
  "version": 1
