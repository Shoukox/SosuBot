<Project>

  <!--
    SixLabors.ImageSharp 3.2.0+ / ImageSharp.Drawing 2.2.0+ fail Release builds without a Six Labors license.
    Only projects that reference those packages directly (SosuBot.Graphics) validate the license.
    The key is never committed: it is taken from $(SixLaborsLicenseKey) (MSBuild property or the environment
    variable of the same name) or, if that is empty, from the git-ignored .secrets/sixlabors.lic file.
    Docker builds mount the same file as a BuildKit secret (id "sixlabors_license").
  -->
  <PropertyGroup Condition="'$(SixLaborsLicenseKey)' == '' and '$(SixLaborsLicenseFile)' == '' and Exists('$(MSBuildThisFileDirectory).secrets/sixlabors.lic')">
    <SixLaborsLicenseFile>$(MSBuildThisFileDirectory).secrets/sixlabors.lic</SixLaborsLicenseFile>
  </PropertyGroup>

</Project>
